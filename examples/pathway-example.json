{
  "mqtt": {
    "broker": "alert.d-t.pw",
    "port": 46942,
    "use_tls": true,
    "ca_cert": "./certs/ca.crt",
    "cert_file": "./certs/client.crt",
    "key_file": "./certs/client.key",
    "input_topic": "alerts/input",
    "status_topic": "alerts/service/status"
  },
  "pathways": {
    "console_alerts": {
      "type": "console",
      "enabled": true,
      "format": "{timestamp} [{level}] {title} - {message}",
      "prefix": "ALERT:"
    },
    "file_log": {
      "type": "file",
      "enabled": true,
      "path": "/var/log/alerts/{date}.log",
      "format": "{timestamp} [{level}] [{category}] {source} [{client}]: {title} - {message}",
      "create_directories": true,
      "append_mode": true,
      "per_client_files": true,
      "client_path_template": "/var/log/alerts/{client}/{date}.log",
      "rotation_period": "weekly"
    },
    "led_sign_main": {
      "type": "led_sign",
      "enabled": true,
      "broker": "alert.d-t.pw",
      "port": 46942,
      "use_tls": true,
      "ca_cert": "./certs/ca.crt",
      "cert_file": "./certs/client.crt",
      "key_file": "./certs/client.key",
      "base_topic": "alerts/output/led/{zone}/",
      "default_zone": "main",
      "zones": {
        "main": {
          "enabled": true,
          "format": "[{level}] {title}: {message}",
          "max_message_length": 200
        }
      }
    },
    "audio_alerts": {
      "type": "mqtt",
      "enabled": true,
      "broker": "alert.d-t.pw",
      "port": 46942,
      "use_tls": true,
      "ca_cert": "./certs/ca.crt",
      "cert_file": "./certs/client.crt",
      "key_file": "./certs/client.key",
      "topic": "alerts/output/audio/{zone}/command",
      "json_payload": true,
      "qos": 1
    },
    "light_indicators": {
      "type": "mqtt",
      "enabled": true,
      "broker": "alert.d-t.pw",
      "port": 46942,
      "use_tls": true,
      "ca_cert": "./certs/ca.crt",
      "cert_file": "./certs/client.crt",
      "key_file": "./certs/client.key",
      "topic": "alerts/output/lights/{zone}/command",
      "json_payload": true,
      "qos": 1
    },
    "mobile_push": {
      "type": "mqtt",
      "enabled": false,
      "broker": "alert.d-t.pw",
      "port": 46942,
      "use_tls": true,
      "ca_cert": "./certs/ca.crt",
      "cert_file": "./certs/client.crt",
      "key_file": "./certs/client.key",
      "topic": "alerts/output/mobile/push",
      "json_payload": true,
      "qos": 1
    },
    "email_alerts": {
      "type": "email",
      "enabled": false,
      "method": "smtp",
      "smtp_server": "smtp.gmail.com",
      "smtp_port": 587,
      "username": "your_email@gmail.com",
      "from_address": "your_email@gmail.com",
      "to_addresses": ["recipient@example.com"],
      "subject_template": "Home Alert: {title}",
      "html_format": false
    },
    "sms_alerts": {
      "type": "mqtt",
      "enabled": false,
      "broker": "alert.d-t.pw",
      "port": 46942,
      "use_tls": true,
      "ca_cert": "./certs/ca.crt",
      "cert_file": "./certs/client.crt",
      "key_file": "./certs/client.key",
      "topic": "alerts/output/sms/send",
      "json_payload": true,
      "qos": 1
    }
  },
  "routing_rules": [
    {
      "name": "Critical Security Alerts",
      "conditions": {
        "level": ["critical"],
        "category": ["security"]
      },
      "pathways": ["led_sign_main", "audio_alerts", "light_indicators", "mobile_push", "email_alerts", "console_alerts", "file_log"]
    },
    {
      "name": "Critical System Alerts",
      "conditions": {
        "level": ["critical"],
        "category": ["system"]
      },
      "pathways": ["led_sign_main", "mobile_push", "email_alerts", "console_alerts", "file_log"]
    },
    {
      "name": "Warning Security Alerts",
      "conditions": {
        "level": ["warning"],
        "category": ["security"]
      },
      "pathways": ["led_sign_main", "audio_alerts", "console_alerts", "file_log"]
    },
    {
      "name": "Warning Weather Alerts",
      "conditions": {
        "level": ["warning"],
        "category": ["weather"]
      },
      "pathways": ["audio_alerts", "console_alerts", "file_log"]
    },
    {
      "name": "Info Automation Alerts",
      "conditions": {
        "level": ["info"],
        "category": ["automation"]
      },
      "pathways": ["audio_alerts", "console_alerts", "file_log"]
    },
    {
      "name": "General Info Alerts",
      "conditions": {
        "level": ["info"]
      },
      "pathways": ["console_alerts", "file_log"]
    },
    {
      "name": "Debug Alerts",
      "conditions": {
        "level": ["debug"]
      },
      "pathways": ["file_log"]
    }
  ]
}