{
  "mqtt": {
    "broker": "alert.d-t.pw",
    "port": 46942,
    "use_tls": true,
    "ca_cert": "./certs/ca.crt",
    "cert_file": "./certs/client.crt",
    "key_file": "./certs/client.key",
    "input_topic": "alerts/input",
    "status_topic": "alerts/service/status"
  },
  "logging": {
    "level": "INFO",
    "console": true,
    "file": "./alerts.log"
  },
  "pathways": {
    "console_alerts": {
      "type": "console",
      "enabled": true,
      "format": "{timestamp} [{level}] {title}: {message}",
      "prefix": "ALERT:"
    },
    "file_log": {
      "type": "file",
      "enabled": true,
      "path": "./alerts.log",
      "format": "{timestamp} [{level}] [{category}] {source}: {title} - {message}",
      "create_directories": true,
      "append_mode": true
    },
    "led_sign": {
      "type": "led_sign",
      "enabled": true,
      "broker": "alert.d-t.pw",
      "port": 46942,
      "use_tls": true,
      "ca_cert": "./certs/ca.crt",
      "cert_file": "./certs/client.crt",
      "key_file": "./certs/client.key",
      "base_topic": "ledSign/{zone}/",
      "default_zone": "main",
      "zones": {
        "main": {
          "enabled": true,
          "format": "[{level}] {title}: {message}",
          "max_message_length": 200
        }
      }
    },
    "email_warnings": {
      "type": "email",
      "enabled": false,
      "from_address": "alerts@yourdomain.com",
      "to_addresses": ["admin@yourdomain.com", "security@yourdomain.com"],
      "subject_template": "[ALERT] {level}: {title}",
      "html_format": true,
      "body_template": "Alert from {source} at {timestamp}:\n\nLevel: {level}\nCategory: {category}\nTitle: {title}\nMessage: {message}"
    },
    "email_critical": {
      "type": "email",
      "enabled": false,
      "from_address": "critical-alerts@yourdomain.com",
      "to_addresses": ["admin@yourdomain.com", "oncall@yourdomain.com"],
      "subject_template": "🚨 CRITICAL ALERT: {title}",
      "html_format": true,
      "level_filter": ["critical"]
    }
  },
  "routing_rules": [
    {
      "name": "Critical Security Alerts",
      "conditions": {
        "level": ["critical"],
        "category": ["security"]
      },
      "pathways": ["console_alerts", "file_log", "led_sign", "critical_email"]
    },
    {
      "name": "Critical System Alerts", 
      "conditions": {
        "level": ["critical"],
        "category": ["system", "network"]
      },
      "pathways": ["console_alerts", "file_log", "led_sign", "email_critical"]
    },
    {
      "name": "Warning Security Alerts",
      "conditions": {
        "level": ["warning"],
        "category": ["security"]
      },
      "pathways": ["console_alerts", "file_log", "led_sign", "email_warnings"]
    },
    {
      "name": "Warning System Alerts",
      "conditions": {
        "level": ["warning"],
        "category": ["system", "network"]
      },
      "pathways": ["console_alerts", "file_log", "led_sign", "email_warnings"]
    },
    {
      "name": "Other Warning Alerts",
      "conditions": {
        "level": ["warning"]
      },
      "pathways": ["console_alerts", "file_log", "led_sign"]
    },
    {
      "name": "Info Alerts",
      "conditions": {
        "level": ["info"]
      },
      "pathways": ["console_alerts", "file_log"]
    },
    {
      "name": "Debug Alerts",
      "conditions": {
        "level": ["debug"]
      },
      "pathways": ["file_log"]
    }
  ]
}