# Alert Manager Environment Configuration Example
# Copy this file to .env and fill in your actual values
# The .env file should NEVER be committed to version control

# Office 365 Graph API Configuration (Required for Email Pathway)
# Email pathway uses O365 Graph API with MSAL authentication (SMTP not supported)
# Get these values from your Azure App Registration:
# 1. Go to https://portal.azure.com
# 2. Navigate to Azure Active Directory > App registrations
# 3. Create new registration or use existing one
# 4. Grant "Mail.Send" API permission (Application type, not Delegated)
# 5. Create a client secret under "Certificates & secrets"
O365_TENANT_ID=your-tenant-id-here
O365_CLIENT_ID=your-client-id-here
O365_CLIENT_SECRET=your-client-secret-here

# Email sender address (optional, can be set in pathway config)
EMAIL_FROM_ADDRESS=alerts@yourdomain.com

# PostgreSQL Database Configuration
# Used by database-logger and analytics-engine services
# Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=your-secure-postgres-password-here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alertmanager
POSTGRES_USER=alertmanager
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Gateway v2 (src/gateway/) session cookie signing/encryption key
# Generate a strong random key: openssl rand -hex 32
GATEWAY_SECRET_KEY=

# External Service API Keys
PUSHOVER_API_KEY=your-pushover-api-key
PUSHOVER_USER_KEY=your-pushover-user-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Feed Aggregator API Keys
# Get your API key from https://api-ninjas.com (free tier: 10,000 requests/month)
API_NINJAS_KEY=your-api-ninjas-key-here

# Webhook URLs
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Debug and Logging
DEBUG_MODE=false
LOG_LEVEL=INFO