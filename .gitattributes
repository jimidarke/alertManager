# Normalize all text files to LF in the repo and on checkout
* text=auto eol=lf

# Be explicit for files where CRLF is actively harmful
*.sh   text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.j2   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.conf text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf

# Binaries — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
