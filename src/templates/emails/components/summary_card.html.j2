{# Summary Card Component - Light Theme #}
{#
   Required:
   - metrics: list of {label, value, color (optional)}
#}

<table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 25px;">
    <tr>
        {% for metric in metrics %}
        <td style="text-align: center; padding: 15px; background-color: #f9f9f9; border-radius: 6px;{% if not loop.last %} border-right: 1px solid #eeeeee;{% endif %}">
            <div style="font-size: 24px; font-weight: 700; color: {{ metric.color|default('#007acc') }};">{{ metric.value }}</div>
            <div style="font-size: 12px; color: #666666; margin-top: 4px;">{{ metric.label }}</div>
        </td>
        {% endfor %}
    </tr>
</table>
