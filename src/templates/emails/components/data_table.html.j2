{# Data Table Component - Light Theme #}
{#
   Required:
   - headers: list of {label, width (optional)}
   - rows: list of {cells: [{value, style (optional)}]}

   Optional:
   - table_title: string
   - table_description: string
#}

{% if table_title %}
<h3 style="margin: 0 0 8px 0; font-size: 15px; color: #333333;">{{ table_title }}</h3>
{% endif %}

{% if table_description %}
<p style="margin: 0 0 15px 0; font-size: 13px; color: #666666;">{{ table_description }}</p>
{% endif %}

<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; font-size: 13px;">
    <thead>
        <tr>
            {% for header in headers %}
            <th style="padding: 10px 12px; text-align: left; background-color: #007acc; color: #ffffff; font-weight: 600; width: {{ header.width|default('auto') }};">{{ header.label }}</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
        {% set row_odd = loop.index is odd %}
        <tr>
            {% for cell in row.cells %}
            <td style="padding: 10px 12px; border-bottom: 1px solid #eeeeee; color: #333333; background-color: {% if row_odd %}#ffffff{% else %}#f9f9f9{% endif %};{% if cell.style %} {{ cell.style }}{% endif %}">{{ cell.value }}</td>
            {% endfor %}
        </tr>
        {% endfor %}
    </tbody>
</table>
