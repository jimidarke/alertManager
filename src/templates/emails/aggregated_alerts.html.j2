<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <!--[if mso]>
    <style type="text/css">
        body, table, td { font-family: Arial, sans-serif !important; }
    </style>
    <![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5; font-family: Arial, Verdana, Helvetica, sans-serif; -webkit-font-smoothing: antialiased;">
    <!-- Wrapper Table -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f5f5f5; padding: 20px 0;">
        <tr>
            <td align="center">
                <!-- Main Container -->
                <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">

                    <!-- Header with Red Accent -->
                    <tr>
                        <td style="padding: 0; border-radius: 8px 8px 0 0; border-top: 4px solid #dc3545;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="padding: 24px 30px; background: linear-gradient(135deg, #ffffff 0%, #fff5f5 100%);">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="vertical-align: middle; text-align: center;">
                                                    <div style="font-size: 28px; font-weight: 700; color: #dc3545; margin: 0; line-height: 1.2;">
                                                        STORM ALERT
                                                    </div>
                                                    <div style="font-size: 14px; color: #666666; margin-top: 6px; font-weight: 500;">
                                                        Multiple Critical Alerts Detected
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Alert Count Badge -->
                    <tr>
                        <td style="padding: 20px 30px 0 30px; text-align: center;">
                            <div style="display: inline-block; background-color: #fdf2f2; border: 2px solid #dc3545; border-radius: 50px; padding: 12px 24px; font-size: 18px; font-weight: 700; color: #dc3545;">
                                {{ alert_count }} Alerts
                            </div>
                        </td>
                    </tr>

                    <!-- Summary Card -->
                    <tr>
                        <td style="padding: 20px 30px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fff3cd; border-radius: 6px; border-left: 3px solid #d68910;">
                                <tr>
                                    <td style="padding: 16px 20px;">
                                        <div style="font-size: 14px; font-weight: 600; color: #856404; margin-bottom: 10px;">
                                            Storm Summary
                                        </div>
                                        <table width="100%" cellpadding="4" cellspacing="0" border="0">
                                            <tr>
                                                <td style="font-size: 13px; color: #856404; width: 40%;">Aggregation Window:</td>
                                                <td style="font-size: 13px; color: #333333; font-weight: 600;">{{ aggregation_window }} seconds</td>
                                            </tr>
                                            <tr>
                                                <td style="font-size: 13px; color: #856404;">Unique Sources:</td>
                                                <td style="font-size: 13px; color: #333333;">{{ unique_sources|join(', ') }}</td>
                                            </tr>
                                            {% if first_timestamp and last_timestamp %}
                                            <tr>
                                                <td style="font-size: 13px; color: #856404;">Time Range:</td>
                                                <td style="font-size: 13px; color: #333333; font-family: 'Courier New', monospace;">
                                                    {{ first_timestamp|datetime_format('%H:%M:%S') }} - {{ last_timestamp|datetime_format('%H:%M:%S') }}
                                                </td>
                                            </tr>
                                            {% endif %}
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Alerts Table -->
                    <tr>
                        <td style="padding: 0 30px 20px 30px;">
                            <div style="font-size: 14px; font-weight: 600; color: #333333; margin-bottom: 12px;">
                                Alert Details
                            </div>
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;">
                                <!-- Table Header -->
                                <tr>
                                    <td style="background-color: #f8f9fa; padding: 10px 12px; font-size: 12px; font-weight: 600; color: #495057; border-bottom: 2px solid #dee2e6; width: 70px;">Time</td>
                                    <td style="background-color: #f8f9fa; padding: 10px 12px; font-size: 12px; font-weight: 600; color: #495057; border-bottom: 2px solid #dee2e6; width: 100px;">Source</td>
                                    <td style="background-color: #f8f9fa; padding: 10px 12px; font-size: 12px; font-weight: 600; color: #495057; border-bottom: 2px solid #dee2e6;">Title / Message</td>
                                </tr>
                                <!-- Alert Rows -->
                                {% for alert in alerts %}
                                <tr{% if loop.index is odd %} style="background-color: #fafafa;"{% endif %}>
                                    <td style="padding: 10px 12px; font-size: 12px; color: #333333; border-bottom: 1px solid #eee; font-family: 'Courier New', monospace; vertical-align: top;">
                                        {{ alert.timestamp|datetime_format('%H:%M:%S') if alert.timestamp else 'N/A' }}
                                    </td>
                                    <td style="padding: 10px 12px; font-size: 12px; color: #333333; border-bottom: 1px solid #eee; vertical-align: top;">
                                        {{ alert.source|default('Unknown') }}
                                    </td>
                                    <td style="padding: 10px 12px; font-size: 12px; color: #333333; border-bottom: 1px solid #eee; vertical-align: top;">
                                        <strong style="color: #dc3545;">{{ alert.title|default('Untitled') }}</strong><br>
                                        <span style="color: #666666;">{{ alert.message|default('')|truncate(120) }}</span>
                                    </td>
                                </tr>
                                {% endfor %}
                            </table>
                        </td>
                    </tr>

                    <!-- Action Notice -->
                    <tr>
                        <td style="padding: 0 30px 30px 30px;">
                            <div style="background-color: #f8d7da; border-left: 3px solid #dc3545; border-radius: 6px; padding: 16px 20px;">
                                <div style="font-size: 13px; color: #721c24; line-height: 1.5;">
                                    <strong style="display: block; margin-bottom: 6px;">Action Required</strong>
                                    Multiple critical alerts were received in rapid succession. This may indicate a system-wide issue requiring immediate investigation.
                                </div>
                            </div>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 20px 30px; background-color: #f9f9f9; border-top: 1px solid #eeeeee; border-radius: 0 0 8px 8px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="text-align: center;">
                                        <div style="font-size: 12px; color: #888888; line-height: 1.6;">
                                            <strong style="color: #007acc;">Alert Manager</strong><br>
                                            Storm Prevention - Aggregated Notification<br>
                                            <span style="font-size: 11px; color: #aaaaaa;">Automated notification - do not reply</span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
