# alert-agent configuration
# Install to /etc/alert-agent/alert-agent.env and chmod 600 (contains credentials).
# All values are KEY=VALUE, sourced by alert-agent.sh.

# --- Required ---------------------------------------------------------------

# Alert Manager gateway base URL (no trailing slash)
ALERT_URL=https://alert.example.com

# Client name this host reports as. REQUIRED. The account used below must hold
# an alerts:write scope for this client, and the client must be registered.
ALERT_CLIENT=acme-co

# Auth: Bearer token (preferred) ...
ALERT_TOKEN=amt_your_token_here
# ... OR Basic auth (used only if ALERT_TOKEN is empty):
#ALERT_USER=svc-acme-host01
#ALERT_PASSWORD=changeme

# --- Thresholds (defaults shown) --------------------------------------------

# Disk usage %, per filesystem. warn re-fires every 24h, critical every hour
# while the condition persists; tier changes always fire immediately.
#DISK_WARN_PCT=90
#DISK_CRIT_PCT=95
#DISK_WARN_REFIRE=86400
#DISK_CRIT_REFIRE=3600

# 5-minute load average as a multiple of CPU cores
#LOAD_WARN_MULT=2
#LOAD_CRIT_MULT=4

# Memory used % (MemAvailable-based)
#MEM_WARN_PCT=90
#MEM_CRIT_PCT=95

# --- Tuning ------------------------------------------------------------------

# Max kernel log lines included per alert message
#KERNEL_MAX_LINES=40

# Local state (debounce timers, kernel cursor, container cache, retry spool)
#STATE_DIR=/var/lib/alert-agent

# Max unsent payloads kept for retry after gateway outages
#SPOOL_MAX=50

# Per-request curl timeout in seconds
#CURL_TIMEOUT=15
