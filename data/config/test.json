{
  "mqtt": {
    "broker": "alert.d-t.pw",
    "port": 46942,
    "use_tls": true,
    "ca_cert": "./certs/ca.crt",
    "cert_file": "./certs/client.crt",
    "key_file": "./certs/client.key",
    "input_topic": "alerts/input",
    "status_topic": "alerts/service/status"
  },
  "logging": {
    "level": "INFO",
    "file": "./logs/ops/alert-router.{date}.log",
    "console": true
  },
  "pathways": {
    "console_alerts": {
      "type": "console",
      "enabled": true,
      "format": "{timestamp} [{level}] {title} - {message}",
      "prefix": "ALERT:"
    },
    "file_log": {
      "type": "file",
      "enabled": true,
      "path": "./logs/file/{date}.log",
      "format": "{timestamp} [{level}] [{category}] {source}: {title} - {message}",
      "create_directories": true,
      "append_mode": true,
      "rotation_period": "weekly"
    },
    "led_sign": {
      "type": "led_sign",
      "enabled": true,
      "broker": "alert.d-t.pw",
      "port": 46942,
      "use_tls": true,
      "ca_cert": "./certs/ca.crt",
      "cert_file": "./certs/client.crt",
      "key_file": "./certs/client.key",
      "base_topic": "ledSign/{zone}/",
      "default_zone": "main",
      "zones": {
        "main": {
          "enabled": true,
          "format": "[{level}] {title}: {message}",
          "max_message_length": 200
        }
      }
    }
  },
  "routing_rules": [
    {
      "name": "Critical Security Alerts",
      "conditions": {
        "level": ["critical"],
        "category": ["security"]
      },
      "pathways": ["led_sign", "console_alerts", "file_log"]
    },
    {
      "name": "Critical System Alerts",
      "conditions": {
        "level": ["critical"],
        "category": ["system"]
      },
      "pathways": ["led_sign", "console_alerts", "file_log"]
    },
    {
      "name": "Warning Alerts",
      "conditions": {
        "level": ["warning"]
      },
      "pathways": ["console_alerts", "file_log"]
    },
    {
      "name": "Info Alerts",
      "conditions": {
        "level": ["info"]
      },
      "pathways": ["file_log"]
    },
    {
      "name": "Debug Alerts",
      "conditions": {
        "level": ["debug"]
      },
      "pathways": ["file_log"]
    }
  ]
}